{
  "name": "shellguard",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "scuttle": "npm run scuttle:dev-start",
    "scuttle:prod": "npm run scuttle:prod-start",
    "scuttle:dev-start": "npm run dev:server & npm run dev",
    "scuttle:dev-stop": "fuser -k 4545/tcp 4646/tcp || true",
    "scuttle:prod-start": "npm run build && (NODE_ENV=production PORT=4646 tsx server.ts & vite preview --port 4545 --host)",
    "scuttle:prod-stop": "npm run scuttle:dev-stop",
    "scuttle:stop": "npm run scuttle:dev-stop",
    "scuttle:reset": "npm run scuttle:stop && tsx scripts/scuttle-reset.ts --env production && rm -rf dist",
    "scuttle:dev-reset": "npm run scuttle:stop && tsx scripts/scuttle-reset.ts --env development",
    "dev": "vite --port 4545 --strictPort",
    "dev:server": "DATA_DIR=./data-dev PORT=4646 tsx --watch server.ts",
    "start:api": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "start": "node server.ts"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^9.1.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "otpauth": "^9.5.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
