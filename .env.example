# ─── ShellGuard Environment Configuration ────────────────────────────────────
# Copy this file to .env and uncomment the settings you need.
# NEVER commit your .env file to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── API Server URL ────────────────────────────────────────────────────────────
# Tells the frontend where the ShellGuard API lives.
#
# Local Dev:         http://localhost:6565      (npm run dev:server / scuttle:dev-start)
# LAN/Self-Hosted:   http://192.168.1.6:6565    (replace with your machine's LAN IP)
# Docker:            Leave unset (relative paths, same-origin single container)
# Custom Domain:     https://vault.yourdomain.com
#
# VITE_API_URL=http://localhost:6565

# ── Client-Side Encryption ───────────────────────────────────────────────────
# VITE_SHELLCRYPTION_ENABLED: Enable client-side resting encryption (ShellCryption™)
# using the VaultKey as the seed material.
# Recommended: true. The server only ever stores ciphertext blobs.
VITE_SHELLCRYPTION_ENABLED=true

# ── Security ──────────────────────────────────────────────────────────────────
# Enable "trust proxy" if the server sits behind a trusted reverse proxy
# (nginx, Caddy, Cloudflare tunnel). Required for correct client IP detection
# in rate limiting and HTTPS redirection.
# TRUST_PROXY=false

# ── CORS Configuration ────────────────────────────────────────────────────────
# Controls which origins may call the API.
#
# LAN/Self-Hosted (default):
#   Leave unset — automatically allows localhost + private IP ranges
#   (192.168.x.x, 10.x.x.x, 172.16-31.x.x, 100.64-127.x.x).
#
# Reverse Proxy / Cloudflare Tunnel:
#   Set to your public origin — only that origin is allowed (comma separated).
#
# CORS_ORIGIN=https://vault.yourdomain.com

# ── Data Storage ──────────────────────────────────────────────────────────────
# Directory holding db.sqlite and the segregated audit.sqlite (default: ./data).
# DATA_DIR=./data

# ── Database Encryption at Rest + Per-Row Metadata Encryption ──────────────────
# This key governs TWO layers of defense-in-depth:
#
#   1. SQLCipher whole-DB encryption — encrypts the entire SQLite file at rest.
#   2. Per-row metadata encryption — encrypts title, username, url, category,
#      notes and file_name columns with AES-256-GCM.  ShellCryption secret
#      blobs are unaffected (they're already encrypted client-side).
#
# When unset, BOTH layers are disabled; metadata is stored plaintext and the
# DB file is unencrypted.  ShellGuard still works — but anyone with file
# access can read vault titles and categories.
#
# Generate with:  openssl rand -base64 32
# STRONGLY advised for production.  Optional for local dev.
# DB_ENCRYPTION_KEY=

# ── SuperLobster Panel (Admin Plane) ──────────────────────────────────────────
# Enables the instance admin panel at /superlobster (URL-only entry — no UI
# links). Manage lobsters, failsafe backups, and the audit reef.
#
# ⚠ This token NEVER decrypts anything — it only opens the panel.
#   Guard it like the keys to the server room.
#
# When unset, the panel is completely disabled (503 on all admin routes).
# Generate with:  openssl rand -base64 32
#
# See ADMIN.md for the full threat model and backup/restore procedures.
# ADMIN_TOKEN=

# ── HTTPS / TLS (Optional) ────────────────────────────────────────────────────
# Native HTTPS without a reverse proxy. Two modes:
#
# 1. Self-signed (frictionless): set TLS_ENABLED=true.
#    • A 10-year EC P-256 certificate is auto-generated on first boot and
#      persisted to DATA_DIR/certs/{cert,key}.pem (reused on every restart).
#    • SANs cover localhost + every LAN interface — one browser warning, once.
#    • Accept the browser warning on first visit (expected with self-signed).
#    • Docker healthcheck handles this automatically (no-check-certificate).
#
# 2. Bring your own: point TLS_CERT_PATH and TLS_KEY_PATH at a PEM pair
#    (e.g. issued by your reverse proxy, mkcert, or an internal CA).
#    Both must be set together; takes precedence over the generated pair.
#
# For LAN deployments behind nginx/Caddy/Tailscale/Cloudflare Tunnel, leave
# everything unset — the proxy terminates TLS and ShellGuard serves plain HTTP
# on the loopback/private interface.
#
# TLS_ENABLED=false
# TLS_CERT_PATH=
# TLS_KEY_PATH=

# Redirect plain-HTTP requests to HTTPS (for public exposure behind a proxy).
# Uses X-Forwarded-Proto when TRUST_PROXY=true.
# ENFORCE_HTTPS=false
# HTTPS_PORT=4647

# ── Token Lifetime ────────────────────────────────────────────────────────────
# Default TTL for issued api- session tokens.
# Accepts: '30m', '12h', '24h', '7d', 'never', an ISO 8601 datetime,
# or a bare number interpreted as minutes (e.g. '1440' = 24 hours).
# TOKEN_TTL_DEFAULT=1440

# ── Rate Limiting (Optional) ──────────────────────────────────────────────────
# Auth endpoint limiting (brute-force protection).
# AUTH_RATE_WINDOW=900000        # window in ms (default 15 minutes)
# AUTH_RATE_LIMIT=10             # max failed attempts per window (default 10)

# Global API limiting (abuse protection).
# API_RATE_WINDOW=60000          # window in ms (default 1 minute)
# API_RATE_LIMIT=100             # max requests per window (default 100)
