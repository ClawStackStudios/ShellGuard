{
  "name": "shellguard",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.0.1.5",
  "type": "module",
  "scripts": {
    "scuttle": "npm run scuttle:dev-start",
    "scuttle:prod": "npm run scuttle:prod-start",
    "scuttle:dev-start": "npm run dev:server & npm run dev",
    "scuttle:dev-stop": "fuser -k 6464/tcp 6565/tcp || true",
    "scuttle:prod-start": "npm run build && (NODE_ENV=production PORT=6565 tsx server.ts & vite preview --port 6464 --host)",
    "scuttle:prod-stop": "npm run scuttle:dev-stop",
    "scuttle:stop": "npm run scuttle:dev-stop",
    "scuttle:reset": "npm run scuttle:stop && tsx scripts/scuttle-reset.ts --env production && rm -rf dist",
    "scuttle:dev-reset": "npm run scuttle:stop && tsx scripts/scuttle-reset.ts --env development",
    "scuttle:restore": "tsx scripts/restore.ts",
    "dev": "vite --port 6464 --strictPort",
    "dev:server": "DATA_DIR=./data-dev PORT=6565 tsx --watch server.ts",
    "start:api": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs --port 6466",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --port 6466",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "start": "node server.ts",
    "test": "vitest run",
    "test:integration": "vitest run tests/auth-flow.test.ts tests/vault-crud.test.ts tests/settings.test.ts",
    "test:security": "vitest run tests/security.test.ts",
    "test:build-gates": "vitest run tests/build-gates.test.ts",
    "test:full": "vitest run"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^9.1.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "otpauth": "^9.5.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "selfsigned": "^5.5.0",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.5"
  }
}
